{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sharaf",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // Static files are free and unlimited; only /api/* runs the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // No database_id on purpose: the first deploy creates the D1 database and links it.
  "d1_databases": [{ "binding": "DB", "database_name": "sharaf" }],
  // One cron: imports new content after a deploy, then sends prayer-time notifications.
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "PUSH_CONTACT": "mailto:admin@example.com" },
  "observability": { "enabled": true }
}
